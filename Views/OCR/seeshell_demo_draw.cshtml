@{
    ViewBag.Title = "Drawing, Drag & Drop and Mouse up/down/mouse over - Demo Page";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-demo">
        <div class="row">
            <div class="span12 whitebg">
                <h1>Demo <span>Drawing</span> with SeeShell</h1>
            </div>
        </div>
    </div>

    <div class="row">


        <div class="span12">

            <p>In a second <a href="http://literallycanvas.com/">SeeShell will click this link</a>, 
            which will bring you to the original Literallycanvas website. Once there, SeeShell will 
            draw (scribble?) a picture on the canvas.

            <p>
                This demo shows how to use the SeeShell and SeeShell Browser mouse commands for drawing, drag and drop and 
                simulating mouse up/down/ever effects. Mouse commands can be combined with image commands, you can 
                copy and paste recorded mouse commands into an image macro and vice versa. 
                The easiest option is to the SeeShell Editor for this, but you can also work with the JSON file directly.


            </p>



        </div>
    </div>
</div>
