                        <td>Yes</td>
                    </tr>


                    <tr>
                        <td><a href="/rpa/docs/visual-ui-testing">Visual UI Testing</a></td>
                        <td>Yes</td>
                        <td>Yes</td>
                        <td>Yes</td>
                    </tr>
                    <tr>
                        <td><a href="/rpa/docs#ocr">OCR</a></td>
                        <td>Yes</td>
                        <td>Yes</td>
                        <td>Yes</td>
                    </tr>
                    <tr>
                        <td><a href="/rpa/x#realuser">Real User Simulation</a></td>
                        <td>-</td>
                        <td>-</td>
                        <td>Yes</td>
                    </tr>
                    <tr>
                        <td><a href="/rpa/x/desktop">Desktop Automation</a></td>
