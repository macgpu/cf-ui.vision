@model OCRReaderMVCWeb.Models.ContactViewModel

@{
    ViewBag.Title = "Contact";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header">
        <div class="row">
            <div class="span12 whitebg">
                <h1><span>Contact</span></h1>
            </div>
        </div>
    </div>


    <div class="row">

        @using (Html.BeginForm("Contact", "OCR", FormMethod.Post, new { id = "ocrContactForm", enctype = "multipart/form-data", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            <div class="span12">
                <h3 class="headline">
                    <span>Contact Us</span>
                </h3>
            </div>

            <p>For sales, tech support and any other question and feedback please 
        use this form. You can also email us directly at <em>team (at) a9t9.com</em>.<br />
         We reply to all emails within 24 hours, and often already within a few minutes.</p>

                <fieldset>


                    
                    @if (!ViewData.ModelState.IsValid)
                {
                        <div id="sucOrErrMesgMainDiv" class="span9">
                            <div id="sucOrErrMesgDiv" class="alert alert-dismissible alert-danger">
                                <button type="button" class="close" data-dismiss="alert">×</button>
                                <strong>
                                    Please correct the following error(s):
                                </strong><br /><br />@Html.ValidationSummary()
                            </div>
                        </div>
                    }
                    else if (ViewBag.IsSuccessfulMessageDelivery != null && (bool)ViewBag.IsSuccessfulMessageDelivery)
                    {
                        <div id="sucOrErrMesgMainDiv" class="span9">
                            <div id="sucOrErrMesgDiv" class="alert alert-dismissible alert-success">
                                <button type="button" class="close" data-dismiss="alert">×</button>
                                <span id="sucOrErrMessage">Your message was sent! You will get a reply within one day.</span>
                            </div>
                        </div>
                    }


                    @*<div class="span9">
                            @Html.ValidationSummary("Please correct the Errors")
                        </div>*@

                    @*<div class="span9">
                            <p></p>
                        </div>*@
                    <div class="span9">
                        <p>Contact Form:</p>
                    </div>
                    <div class="span9">
                        <p>Name*</p>
                    </div>
                    <div class="span9">
                        @Html.EditorFor(model => model.ContactName, new { htmlAttributes = new { @class = "form-control choose" } })
                    </div>
                    <div class="span9">
                        <p>Email*</p>
                    </div>
                    <div class="span9">
                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control choose" } })
                    </div>

                    @*<div class="span3">
                            <p>Phone*</p>
                        </div>

                        <div class="span3">
                            @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control choose" } })
                        </div>*@

                    <div class="span9">
                        <p>Subject*</p>
                    </div>
                    <div class="span9">
                        @Html.EditorFor(model => model.Subject, new { htmlAttributes = new { @class = "form-control choose" } })
                    </div>

                    <div class="span3">
                        <p>Message*</p>
                    </div>
                    <div class="span9">
                        @Html.TextAreaFor(model => model.Message, new { @class = "form-control" })
                    </div>

                    <div class="span3">
                        <a id="btnContact" class="example-image-link btn btn-large btn-green-light" onclick="submitContactForm();">Send Message</a>
                    </div>
                </fieldset>
                }


            </div>
</div>
