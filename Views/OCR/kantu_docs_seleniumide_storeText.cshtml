            <h3>storeText Example</h3>

            <p>
                <table class="table table-bordered">
                    <thead>
                    <th class="col-md-2">Command</th>
                    <th class="col-md-5">Target</th>
                    <th class="col-md-5">Pattern/Text</th>
                    </thead>
                    <tbody>

                        <tr>
                            <td>open</td>
                            <td>https://ui.vision/</td>
                            <td></td>
                        </tr>
                        <tr class="success">
                            <td>storeText</td>
                            <td>//*[@@id="content"]/div[2]/div/h2[1]</td>
                            <td>name</td>
                        </tr>
                        <tr>
                            <td>echo</td>
                            <td>Name var = ${name}</td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </p>

