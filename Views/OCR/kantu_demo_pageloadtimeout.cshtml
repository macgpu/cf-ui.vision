@{
    ViewBag.Title = "Wait for Page Load Event - Demo";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-demo">
        <div class="row">
            <div class="span12 whitebg">
                <h1>Simulate <span>Slow Loading Page</span></h1>
            </div>
        </div>
    </div>

    <div class="row">

<p>This page has five slow loading image elements that take up to 30 seconds to load. Only then is the page completely loaded.</p>

        <div class="span12">
            <section>
                <ul class="row thumbnails">
                    <li class="span2" style="text-align: center;">
                        <h4>delayed 1 second</h4>
                        <div class="thumbnail" style="height:193px;">
                            <img src="http://deelay.me/1000/https://ui.vision/Content/Images/delay1s.webp">
                        </div>
                    </li>
                    <li class="span2" style="text-align: center;">
                        <h4>delayed 5 seconds</h4>
                        <div class="thumbnail" style="height:193px;">
                            <img src="http://deelay.me/5000/https://ui.vision/Content/Images/delay5s.webp">
                        </div>
                    </li>
                    <li class="span2" style="text-align: center;">
                        <h4>delayed 10s</h4>
                        <div class="thumbnail" style="height:193px;">
                            <img src="http://deelay.me/10000/https://ui.vision/Content/Images/delay10s.webp">
                        </div>
                    </li>
                    <li class="span2" style="text-align: center;">
                        <h4>delayed 20s</h4>
                        <div class="thumbnail" style="height:193px;">
                            <img src="http://deelay.me/20000/https://ui.vision/Content/Images/delay20s.webp">
                        </div>
                    </li>
                    <li class="span2" style="text-align: center;">
                        <h4>delayed 30s</h4>
                        <div class="thumbnail" style="height:193px;">
                            <img src="http://deelay.me/30000/https://ui.vision/Content/Images/delay30s.webp">
                        </div>
                    </li>


                </ul>
            </section>
        </div>
    </div>
</div>
