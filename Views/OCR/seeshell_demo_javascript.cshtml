@{
    ViewBag.Title = "Run Javascript, Evaluate Javascript and Right-click - Demo Page";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-demo">
        <div class="row">
            <div class="span12 whitebg">
                <h1>Demo <span>Javascript</span></h1>
            </div>
        </div>
    </div>

    <div class="row">


        <div class="span12">
            <p>
                This page is used by the Demo-Javascript macro to demo Javascript execution
                with the Javascript command, to show the SeeShell Browser's ability to catch Javascript alerts, and finally
                to demo a visual right-click.
            </p>
            <h2>Run Javascript inside the macro</h2>
            <form>
                Today's date and time (and later Youtube URL):  <input type="text" size="70" id="t1"><br>
                Select Box (set by a Javascript command):
                <select id="tesla">
                    <option value="buy">Select your next Tesla</option>
                    <option value="s">Model S</option>
                    <option value="3">Model 3</option>
                    <option value="x">Model X</option>
                    <option value="y">Model Y</option>
                </select>
            </form>

            <h2>Catch Javascript alerts</h2>
            <p>
                <button onclick="myFunction1()">Alert Box</button>    <button onclick="myFunction2()">Confirm </button>      <button onclick="myFunction3()">Prompt</button>
            </p>


            <h2>Do context-menu right-clicks</h2>
            <p>We show this by right-clicking on this Youtube video. The copied URL is stored inside the ${!PASTE} variable.</p>

            <center>
                <iframe width="560" height="315" src="https://www.youtube.com/embed/Q7neEST2dWE" frameborder="0" allowfullscreen></iframe>
            </center>
            <p>

                <a href="https://www.youtube.com/watch?v=Q7neEST2dWE">youtube</a>


                <script>
                    function myFunction1() {
                        alert("Hello\nHow are you?");
                    }

                    function myFunction2() {
                        confirm("Press a button!");
                    }
                   function myFunction3() {
                            var person = prompt("Please enter your name", "Harry Potter");
                            if (person != null) {
                                document.getElementById("demo").innerHTML =
                                "Hello " + person + "! How are you today?";
                            }
                   }
                </script>


</div>
    </div>
</div>
