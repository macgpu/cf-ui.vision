@{
    ViewBag.Title = "Firefox - Differences to Chrome/Edge";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-extension">
        <div class="row">
            <div class="span12 whitebg">
                <h1>One thing is different in <span>Firefox</span></h1>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="span12">
            <h3 class="headline">
                <span>Ui.Vision RPA software for Firefox. Differences to Chrome/Edge</span>
            </h3>
        </div> 

        <div class="span12">


            <h3 id="permission">Grant Permission To Replay Macros</h3>

            <p>Ui.Vision is an open-source tool for automating browser tasks. To replay macros, it requires permission from Firefox to 'access data in all tabs'. You must grant this permission explicitly after the installation:
              
            </p>
            <p>
                <img src="~/Content/Images/firefox-permission-dialog2.jpg" alt="How to allow access to all tabs in Firefox" class="responsive-img">
                </br><em>
    After installation, you need to explicitly allow that Ui.Vision can access content in your browser tabs.
    The RPA software needs the permission for browser automation. If you use the RPA software only for <a href="/rpa/x/desktop-automation">desktop automation</a>, this permission is not needed.
</em>
            </p>

            <p>
                <img src="~/Content/Images/firefox-rpa-permissions.jpg" alt="How to change the RPA permissions in Firefox" class="responsive-img">
                </br><em>
                   If needed, you can always change this permission later in the extension settings.
                </em>
            </p>

            <h3>Anything wrong or missing on this page? Suggestions?</h3>
            <p>...then please <a href="/contact">contact us</a>.</p>


        </div>
    </div>
</div>
