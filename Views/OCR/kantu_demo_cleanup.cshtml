@{
    ViewBag.Title = "Clean Up: Close all other tabs, delete cookies";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-demo">
        <div class="row">
            <div class="span12 whitebg">
                <h1>All other <span>tabs closed</span> in 15 seconds</h1>
            </div>
        </div>
    </div>

    <div class="row">


        <div class="span12">
            <p> <span class="hired">This demo macro will close all other tabs except this one and delete all cookies in 15 seconds.</span>
            
            </p>
            <p>If this is not want you want - maybe you have some work open in other tabs? - please press STOP now.</p>
            <p>
                <form>
                    Cleanup Count-Down:  <input type="text" size="70" id="info">
                </form>
            </p>

</div>
    </div>
</div>
