@{
    ViewBag.Title = "Flight Search and Date Controls - Demo Page";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-demo">
        <div class="row">
            <div class="span12 whitebg">
                <h1>Demo <span>Flight Search and Date Controls</span></h1>
            </div>
        </div>
    </div>

    <div class="row">


        <div class="span12">

            <p>
                In a few seconds <a href="https://matrix.itasoftware.com/">SeeShell will click this link</a>,
                which will bring you to the original Google ITA flight search form.

            <p>This demo shows how to use the SeeShell Browser to complete complex forms with ease - including tricky
            date controls that no other software can automate this easily.
           </br>The demo macro shows how to automate a "classic select box" by sending "{DOWN}{ENTER}" commands to it. 
           </br>And it includes the SET FINDIMAGECOMMANDTIMEOUT 120 (seconds) to make the SeeShell Browser wait for up to 2 minutes
                  for the search result.
            
            </p>
 



        </div>
    </div>
</div>
