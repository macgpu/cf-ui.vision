@{
    ViewBag.Title = "SeeShell Desktop Automation";
}

<div id="content">

    <div class="row">


        <div class="col-sm-7">


            <h3 class="headline">
                <span>SeeShell Computer Vision</span>
            </h3>
    
            @{
                var xversion = Request.Params["info"];
                // https://ui.vision/x/s?SeeShell=Browser&m1=GettingStarted&m2=CheckingForUpdates&v=3.1.0.0B111PXX

                if (!xversion.IsEmpty())
                {
                    if (xversion.Contains("updateavailable"))
                    {

                        <h3>
                            New SeeShell Update available!
                        </h3>
                        <p>
                            <span class="hired">SeeShell V3.3.0.3 (Beta)</span> is available for <a href="/download">download</a>.
                            <br />
                            For more details see <a href="/seeshell/whatsnew">What's New</a>.
                        </p>
                            <p>
                                <a href="/seeshell/whatsnew">
                                    <img src="~/Content/Images/newupdate.webp" alt="New SeeShell version available" class="responsive-img">
                                </a>
                            </p>
                    }
                }

            }


            <h3>SeeShell - Tip of the week</h3>

            <p>In the editor, press the function key [F1] or select "Help for this command" from the context menu to bring up <a href="/seeshell/docs#ref">information about each command</a>.</p>
            <p>
                <img src="~/Content/Images/seeshell-editor-f1.webp" alt="Editor - Press F1 for Help" class="responsive-img">
            </p>

        <h3>SeeShell Image-Driven Automation explained</h3>
        <p>

            <iframe width="500" height="315" src="https://www.youtube-nocookie.com/embed/fmVhbFqN9gQ?rel=0&&cc_load_policy=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            </br>The video explains the SeeShell concept.
        </p>

        <h3>SeeShell demo scripts explained:</h3>

        <p>
            <iframe width="500" height="315" src="https://www.youtube-nocookie.com/embed/nGooCF3_ykQ?rel=0" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            </br>(No sound.) This short video runs the  demo scripts and gives a few tips and tricks for successful desktop automation.
             </p>

        <p>
            More information is available in the <a href="/seeshell/docs">SeeShell User Manual</a>, 
            including a <a href="/seeshell/docs#ref">complete command reference</a>.
           </p>
            <p>
                Make sure you try the <a href="/seeshell/api">SeeShell API</a>. Example scripts are included in the <em>/Documents/SeeShell.Browser/API</em> folder.
            </p>

            <h3 class="headline">
                <span>Tech Support</span>
            </h3>

            <p>For support please post your question in our <a href="https://forum.ocr.space/">SeeShell Community forum</a>.
</p>

            <p>Direct 1:1 tech support via <a href="..\contact">email</a>, screen sharing and phone is available for users of our <a href="/compare">SeeShell PRO editions</a>.</p>


        <h3 class="headline">
            <span>&#x261b; Share SeeShell Desktop Automation</span>
        </h3>

        <p>
            The more people use SeeShell, the better it becomes over time. Please help making SeeShell better by sharing it on Facebook, Twitter,...
            - or, classic, by linking back to  <span class="hired">https://ui.vision/SeeShell</span>.
        </p>

        <p></p>
        <p><em>You can change or disable this start page in the settings of the SeeShell <a href="\seeshell\compare">PRO Edition</a></em></p>


    </div>



    <div class="col-sm-5">
        <h3 class="headline">
            <span>SeeShell/A9T9 News</span>
        </h3>
        <p>
            <center>
                <a class="twitter-timeline" data-width="350" data-height="1388" href="https://twitter.com/A9T9_com">SeeShell News (via @@a9t9_com)</a>
                <script async src="//platform.twitter.com/widgets.js" charset="utf-8"></script>
            </center>
        </p>
    </div>

</div>
