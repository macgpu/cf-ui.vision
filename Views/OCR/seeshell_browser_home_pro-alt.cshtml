@{
    ViewBag.Title = "SeeShell PRO";
}

<div id="content">

    <div id="page-header" class="page-kantuweb">
        <div class="row">
            <div class="span12 whitebg">
                <h1><span>SeeShell PRO</span> Start Page</h1>
            </div>
        </div>
    </div>

    <div class="row">




        @{
            string xversion = Request.Params["version"];

            if (xversion == "xxxx2.0.5.0")
            {
                <text>
                    <div class="span12">
                        <h3 class="headline">
                            <span>New SeeShell Update available! (V2.0.5)</span>
                        </h3>
                        <p> <span class="hired">SeeShell V2.0.5</span> is a <a href="https://ui.vision/blog/kantu-v2.05-released.html">SeeShell update</a> that includes 
                        the latest Chromium V57 browser engine.</p>
                        <p>You can <a href="/download">download the update here</a> and get <a href="https://ui.vision/blog/kantu-v2.05-released.html">more information</a> on our blog.</p>
                    </div>
                </text>
            }

        }




        <div class="span12">
            <h3 class="headline">
                <span>SeeShell PRO Edition</span>
            </h3>
        </div>

        <div class="span12">

          <p>Happy automating with SeeShell PRO. </p>
            
            <a href="/rpa/docs">
                <img src="~/Content/Images/seeshellkantuhowto.webp"  alt="The SeeShell user-interface - Happy Automating!" class="responsive-img">
            </a>

            <p> <br />For more information see the complete <a href="/rpa/docs">SeeShell Documentation</a> 
            and the <a href="/rpa/docs#faq">most frequently asked questions (FAQ)</a>.</p>


            <h3 class="headline">
                <span>More information and Tech Support</span>
            </h3>

            <p>Make sure you use the <a href="/rpa/docs#api">SeeShell API</a>. It brings super-powers to your web automation. Example scripts are included in the <em>/Documents/SeeShell/API</em> folder.
            </p>


            <p>Tech support: Email <em>team@ui.vision</em> or use the  <a href="..\contact">contact form</a>. In your email, please add your PRO license key. This way your email 
            automatially moves to the top of our stack. We typically respond <em>within 1-2 hours</em> during working hours, but for sure within 24 hours.</p>

            <center>
                <img src="~/Content/Images/kantulogo.webp" alt="Hello!" class="responsive-img">
            </center>

        </div>
    </div>
</div>
