@{
    ViewBag.Title = "Selenium IDE store, storeEval,  Demo Page";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-demo">
        <div class="row">
            <div class="span12 whitebg">
                <h1>Demo <span>Store</span> Selenium IDE</h1>
            </div>
        </div>
    </div>

    <div class="row">


        <div class="span12">
            <p>
                This page is used by the Demo-Store macro to demo the various store commands, including running Javascript.
            </p>

            <h2>Input box to display some results</h2>
            <p>
                <input type="text" size="70" id="sometext"><br>
            </p>

            <h2>Catch Javascript alerts</h2>
            <p>
                <button onclick="myFunction1()">Alert Box</button>    <button onclick="myFunction2()">Confirm </button>      <button onclick="myFunction3()">Prompt</button>
            </p>

            <h2>Run Javascript inside the macro</h2>
            <form>
                Today's date and time (and later Youtube URL):  <input type="text" size="70" id="t1"><br>
                Select Box (set by a Javascript command):
                <select id="tesla">
                    <option value="buy">Select your next Tesla</option>
                    <option value="s">Model S</option>
                    <option value="3">Model 3</option>
                    <option value="x">Model X</option>
                    <option value="y">Model Y</option>
                </select>
            </form>

            <h2>Get Checkbox status with storeChecked</h2>
            <form action="">
               <input type="checkbox" name="vehicle" value="bike" checked="checked">↑ I have a bike
                <input type="checkbox" name="vehicle" value="boat"> ↑ I have a boat
                <input type="checkbox" name="vehicle" value="car">↑ I have a car
            </form>

        

            <h2>Extract data from the raw HTML with sourceExtract</h2>

            <p>With sourceSearch you can search the source code and count items, and with sourceExtract you can extract data. 
            Both commands support "*" and regular expressions. In the DemoExtract macro we will extract the prices, the parameters 11,22,33 and the Google Analytics ID of this page.</p>
            <p>
                <ul>
                    <li>Coffee $2.95</li>
                    <li>Tea $1.95</li>
                    <li>Milk $2.50</li>
                </ul>
            </p>       
            <p>
                Another Regex demo string: "_width: 11, _width: 22, _width: 33"
            </p>

            <h2>Test POSition attribute</h2>
            <p>All link names are the same, but with @@pos=2 you can tell <em>Ui.Vision RPA</em> to select e. g. the second line of the same name.</p>

            <p>
                <ul>
                    <li>
                        <a href="/">This link</a> goes to main homepage
                    </li>
                    <li>
                        <a href="/kantu">This link</a> goes to web extension homepage
                    </li>
                    <li>
                        <a href="/rpa/docs/selenium-ide">This link</a> lists all Selenium IDE commands
                    </li>
                    <li>
                        <a href="/rpa/docs/selenium-ide/capturescreenshot">This link</a> explains how to take screenshot
                    </li>
                    <li>
                        <a href="http://www.7-zip.org/download.html">This link</a> goes to 7zip.org, where you will find a great real live example of many links with the same name.
                    </li>
                </ul>


            </p>




            <script>
                function myFunction1() {
                    alert("Hello\nHow are you?");
                }

                function myFunction2() {
                    confirm("Press a button!");
                }
                function myFunction3() {
                    var person = prompt("Please enter your name", "Harry Potter");
                    if (person != null) {
                        document.getElementById("demo").innerHTML =
                            "Hello " + person + "! How are you today?";
                    }
                }
            </script>


        </div>

    </div>
</div>
