@{
    ViewBag.Title = "comment - Selenium IDE Commands Tutorial";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-extension">
        <div class="row">
            <div class="span12 whitebg">
                <h1><span>comment</span> - Selenium IDE</h1>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="span12">
            <h3 class="headline">
                <span>comment - Selenium IDE command</span>
            </h3>
        </div>

        <div class="span12">

            <p> <span class="hired">comment</span> adds a comment.</p>

            <p>
                <img src="~/Content/Images/kantu-comment-in-out.gif" alt="Comment in/out" class="responsive-img">
  
            </p>
            <p>
                New: <em>Convert a command to a comment and back</em> with just a mouse click. The ability to comment-in (enable) or to comment-out (disable) a command is useful during macro creation.
            </p>

            <h3>comment Example</h3>

            <p>
                <table class="table table-bordered">
                    <thead>
                    <th class="col-md-2">Command</th>
                    <th class="col-md-5">Target</th>
                    <th class="col-md-5">Pattern/Text</th>
                    </thead>
                    <tbody>

                        <tr>
                            <td>open</td>
                            <td>https://ui.vision/</td>
                            <td><br /></td>
                        </tr>
                        <tr class="success">
                            <td>comment</td>
                            <td>Anything can be put here</td>
                            <td>-</td>
                        </tr>
                    </tbody>
                </table>
            </p>

            <h3>Works in</h3>
            <p>
                <em>Ui.Vision RPA</em> for Chrome <a href="/">Selenium IDE</a>,  <em>Ui.Vision RPA</em> for Firefox <a href="/">Selenium IDE</a>,   <a href="/howto/getseleniumide/">Firefox IDE Classic</a>
            </p>

            <h3>Related Demo Macros</h3>
            <p>Demo-Autofill, Demo-Frame</p>
            <p>The ready-to-import-and-run source code of all demo macros can be found in the <a href="https://github.com/A9T9/RPA/tree/master/macros">Open-Source RPA software</a> Github repository.</p>

