@{
    ViewBag.Title = "addSelection, removeSelection - Selenium IDE Commands Tutorial";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-extension">
        <div class="row">
            <div class="span12 whitebg">
                <h1><span>addSelection, removeSelection</span> - Selenium IDE</h1>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="span12">
            <h3 class="headline">
                <span>addSelection (locator, option locator),  removeSelection (locator, option locator) - Selenium IDE command</span>
            </h3>
        </div> 

        <div class="span12">

            <p>
                The  <span class="hired">addSelection</span> command adds a selection to the set of options in a multi-select element.
                And the  <span class="hired">removeSelection</span> command remove a selection from the set of selected options
                in a multi-select element using an option locator.
            </p>
            <p>
                The command is automatically recorded.
            </p>

            <h3>addSelection/removeSelection Example</h3>
            <p>
                Multi-select boxes let the user select more than one option in the list. And with the "add Selection" and "remove Selection" 
                commands you can automate this task.
                This example allows you to select your favorite species of flamingo.
                You may control-click (Windows) or command-click (Mac) to select more than one. <em>Ui.Vision RPA</em> records your clicks and adds addSelection and removeSelection
                commands automatically.
            </p>

            <select multiple size="6">
                <option value="American">American flamingo</option>
                <option value="Andean">Andean flamingo</option>
                <option value="Chilean">Chilean flamingo</option>
                <option value="Greater">Greater flamingo</option>
                <option value="James's">James's flamingo</option>
                <option value="Lesser">Lesser flamingo</option>
            </select>

            <p>
                <table class="table table-bordered">
                    <thead>
                    <th class="col-md-2">Command</th>
                    <th class="col-md-5">Target</th>
                    <th class="col-md-5">Pattern/Text</th>
                    </thead>
                    <tbody>

                        <tr>
                            <td>open</td>
                            <td>https://ui.vision/docs/selenium-ide/addselection-removeselection</td>
                            <td></td>
                        </tr>
                        <tr class="success">
                            <td>addSelection</td>
                            <td>xpath=//*[@@id=\"content\"]/div[2]/div[2]/select</td>
                            <td>label=Andean flamingo</td>
                        </tr>
                        <tr class="success">
                            <td>addSelection</td>
                            <td>xpath=//*[@@id=\"content\"]/div[2]/div[2]/select</td>
                            <td>label=Greater flamingo</td>
                        </tr>
                        <tr class="success">
                            <td>removeSelection</td>
                            <td>xpath=//*[@@id=\"content\"]/div[2]/div[2]/select</td>
                            <td>label=Andean flamingo</td>
                        </tr>
                    </tbody>
                </table>
            </p>

            <h3>Works in</h3>
            <p>
                <em>Ui.Vision RPA</em> for Chrome <a href="/">Selenium IDE</a>,  <em>Ui.Vision RPA</em> for Firefox <a href="/">Selenium IDE</a>,   <a href="/howto/getseleniumide/">Firefox IDE Classic</a>
            </p>

