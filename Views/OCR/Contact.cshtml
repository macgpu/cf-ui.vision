@model OCRReaderMVCWeb.Models.ContactViewModel

@{
    ViewBag.Title = "Contact the Ui.Vision Team (Sales and Support)";
}

<div id="content">
    <!--  CONTENT   -->
    <div id="page-header" class="page-contact">
        <div class="row">
            <div class="span12 whitebg">
                <h1><span>Contact</span></h1>
            </div>
        </div>
    </div>


    <div class="row">

        @using (Html.BeginForm("Contact", "OCR", FormMethod.Post, new { id = "ocrContactForm", enctype = "multipart/form-data", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            <div class="span12">
                <h3 class="headline">
                    <span>Contact Us</span>
                </h3>
            </div>

            <p>
        If you need help with sales or PRO/Enterprise support, please fill out this form. 
        You can also reach us directly by email at <em>team (at) ui.vision</em>.</p>
        <p>For support with the free version, check out the <a href="https://forum.ocr.space">user forum</a>. 
        Our tech team and many experienced <em>Ui.Vision</em> users are active there.
        The forum is a great resource since everyone benefits from the shared questions and answers. 
        If your question fits a public forum, we kindly ask you to post it there first.
        </p>

            <fieldset>



                @if (!ViewData.ModelState.IsValid)
                {
                    <div id="sucOrErrMesgMainDiv" class="span9">
                        <div id="sucOrErrMesgDiv" class="alert alert-dismissible alert-danger">
                            <button type="button" class="close" data-dismiss="alert">×</button>
                            <strong>
                                Please correct the following error(s):
                            </strong><br /><br />@Html.ValidationSummary()
                        </div>
                    </div>
                }
                else if (ViewBag.IsSuccessfulMessageDelivery != null && (bool)ViewBag.IsSuccessfulMessageDelivery)
                {
                    <div id="sucOrErrMesgMainDiv" class="span9">
                        <div id="sucOrErrMesgDiv" class="alert alert-dismissible alert-success">
                            <button type="button" class="close" data-dismiss="alert">×</button>
                            <span id="sucOrErrMessage">Your message was sent! You will get a reply within one day.</span>
                        </div>
                    </div>
                }


                @*<div class="span9">
                    @Html.ValidationSummary("Please correct the Errors")
                </div>*@

                @*<div class="span9">
                    <p></p>
                </div>*@
                <div class="span9"></div>

                <div class="span9">
                    @Html.LabelFor(model => model.ContactName, "Name*")
                </div>
                <div class="span9">
                    @Html.EditorFor(model => model.ContactName, new { htmlAttributes = new { @class = "form-control choose " } })
                </div>
                <div class="span9">
                    @Html.LabelFor(model => model.Email, "Email*")
                </div>
                <div class="span9">
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control choose" } })
                </div>

                <div class="span9">
                    @Html.LabelFor(model => model.WhatSoftware, "Please select the topic*")
                </div>
                <div class="span9">
                    @Html.DropDownListFor(model => model.WhatSoftware,
                   new List<SelectListItem>
                   {
                       new SelectListItem { Value = "Sales", Text = "Sales/License Quesition" },
                       new SelectListItem { Value = "FreeSupport", Text = "Support: Ui.Vision Free Edition -> Please use forum instead" },
                       new SelectListItem { Value = "PROSupport", Text =  "Support: Ui.Vision PRO Edition" },
                       new SelectListItem { Value = "EnterpriseSupport", Text = "Support: Ui.Vision Enterprise Edition [Priority Support]" },
                       new SelectListItem { Value = "GeneralInquiry", Text = "General Inquiry" }
                   }, "--- Please select topic ---", new { htmlAttributes = new { @class = "form-control choose" } })
                </div>
                @*<div class="span3">
                    <p>Phone*</p>
                </div>

                <div class="span3">
                    @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control choose" } })
                </div>*@

                <div class="span9">
                    @Html.LabelFor(model => model.antispam, "Please enter the number \"899\" into the field below (Anti-spam check)")
                </div>
                <div class="span9">
                    @Html.EditorFor(model => model.antispam, new { htmlAttributes = new { @class = "form-control choose" } })
                </div>
                <div class="span9">
                    @Html.LabelFor(model => model.Subject, "Subject*")
                </div>
                <div class="span9">
                    @Html.EditorFor(model => model.Subject, new { htmlAttributes = new { @class = "form-control choose" } })
                </div>

                <div class="span3">
                    @Html.LabelFor(model => model.Message, "Message*")
                </div>
                <div class="span9">
                    @Html.TextAreaFor(model => model.Message, new { @class = "form-control" })
                </div>

                <div class="span3">
                    <a id="btnContact" class="example-image-link btn btn-large btn-green-light" onclick="submitContactForm();">Send Message</a>
                </div>
            </fieldset>
        }


    </div>
</div>
